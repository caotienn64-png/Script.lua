--========================================================
-- DRAG (PC + MOBILE)
--========================================================

local dragging = false
local dragStart
local startPos

local function updateDrag(input)
    local delta = input.Position - dragStart
    local pos = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
    Main.Position = pos
    Shadow.Position = pos
end

Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        updateDrag(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

--========================================================
-- SERVER HOPPER
--========================================================

local busy = false

local function setStatus(text)
    Status.Text = "● " .. text
end

local function fetchServers(cursor)
    local url =
        "https://games.roblox.com/v1/games/" ..
        tostring(PLACE_ID) ..
        "/servers/Public?sortOrder=Asc&limit=100"

    if cursor and cursor ~= "" then
        url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
    end

    local ok, result = pcall(function()
        return game:HttpGet(url)
    end)

    if not ok then
        return nil, "HTTP ERROR"
    end

    local decodedOk, data = pcall(function()
        return HttpService:JSONDecode(result)
    end)

    if not decodedOk or type(data) ~= "table" then
        return nil, "JSON ERROR"
    end

    return data
end

local function findOnePlayerServer()
    local cursor = nil

    for _ = 1, 8 do
        local data, err = fetchServers(cursor)
        if not data then
            return nil, err
        end

        if type(data.data) == "table" then
            for _, server in ipairs(data.data) do
                local playing = tonumber(server.playing) or 0
                local maxPlayers = tonumber(server.maxPlayers) or 0
                local id = server.id

                if id
                    and id ~= game.JobId
                    and playing == TARGET_PLAYERS
                    and maxPlayers > playing then
                    return id
                end
            end
        end

        cursor = data.nextPageCursor
        if not cursor or cursor == "" then
            break
        end

        task.wait(0.15)
    end

    return nil, "KHÔNG TÌM THẤY"
end

local function hop()
    if busy then return end
    busy = true

    Button.Text = "ĐANG TÌM SERVER..."
    Button.Active = false
    setStatus("ĐANG QUÉT SERVER 1 PLAYER")

    local serverId, err = findOnePlayerServer()

    if serverId then
        setStatus("ĐANG TELEPORT...")
        Button.Text = "TELEPORTING..."

        task.wait(0.25)

        local ok = pcall(function()
            TeleportService:TeleportToPlaceInstance(
                PLACE_ID,
                serverId,
                Player
            )
        end)

        if not ok then
            setStatus("TELEPORT THẤT BẠI")
            Button.Text = "THỬ LẠI"
            Button.Active = true
            busy = false
        end
    else
        setStatus(err or "KHÔNG CÓ SERVER")
        Button.Text = "SERVER 1 PLAYER"
        Button.Active = true
        busy = false
    end
end

